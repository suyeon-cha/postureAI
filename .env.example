# FlowReset configuration. Copy to .env or export before uvicorn.
#
# Every value here is a path or a loopback/LAN address. There is no API key in
# this file and there must never be one — agent/llm.py raises NonLocalEndpoint
# at import time if the inference endpoint is not loopback or RFC1918.

# ── local inference (Ollama on the box) ──
FLOWRESET_OLLAMA=http://127.0.0.1:11434
FLOWRESET_REASON_MODEL=qwen3:8b
FLOWRESET_VISION_MODEL=qwen2.5vl:7b
FLOWRESET_LLM_TIMEOUT=45

# ── agent runtime ──
# native | nemoclaw | openclaw
# `native` is a working tool-calling loop and the default. Switch to the
# approved stack on the box after filling the TODO(box) lines in runtime.py.
FLOWRESET_RUNTIME=native
FLOWRESET_MAX_STEPS=6

# ── models from the USB drive ──
FLOWRESET_POSE_MODEL=models/pose_landmarker_heavy.task
FLOWRESET_PIPER_VOICE=models/en_US-amy-medium.onnx
FLOWRESET_PIPER_BIN=piper
FLOWRESET_WHISPER_MODEL=models/faster-whisper-base.en
FLOWRESET_WHISPER_DEVICE=auto

# ── local memory ──
FLOWRESET_DB=flowreset.db
